{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "palm",
  "name": "Zanpay Docs",
  "colors": {
    "primary": "#4c641c",
    "light": "#d6f88a",
    "dark": "#4c641c"
  },
  "appearance": {
    "default": "dark"
  },
  "background": {
    "color": {
      "light": "#f8faf4",
      "dark": "#151516"
    }
  },
  "fonts": {
    "heading": {
      "family": "Manrope",
      "weight": 800
    },
    "body": {
      "family": "Manrope",
      "weight": 500
    }
  },
  "favicon": "/favicon.svg",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "search": {
    "prompt": "Buscar na documentação"
  },
  "navigation": {
    "languages": [
      {
        "language": "pt-BR",
        "default": true,
        "groups": [
          {
            "group": "Primeiros passos",
            "pages": [
              "index",
              "quickstart",
              "guias/autenticacao",
              "guias/idempotencia"
            ]
          },
          {
            "group": "Pagamentos Pix",
            "pages": [
              "guias/cobrancas",
              "guias/saques"
            ]
          },
          {
            "group": "Referência",
            "pages": [
              "referencia/criar-cobranca",
              "referencia/consultar-cobranca",
              "referencia/checar-acesso-saque",
              "referencia/solicitar-saque",
              "referencia/consultar-saque",
              "referencia/erros"
            ]
          },
          {
            "group": "Webhooks",
            "pages": [
              "webhooks/configuracao",
              "webhooks/eventos"
            ]
          }
        ]
      }
    ]
  },
  "api": {
    "openapi": [
      "openapi.json"
    ],
    "playground": {
      "display": "simple"
    },
    "examples": {
      "languages": [
        "curl",
        "javascript",
        "python"
      ],
      "prefill": true
    }
  },
  "seo": {
    "metatags": {
      "description": "Documentação oficial da API Zanpay para cobranças Pix, saques e webhooks."
    }
  }
}
